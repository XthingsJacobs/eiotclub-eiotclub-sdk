{
  "name": "eiotclub/eiotclub-sdk",
  "version": "1.0.1",
  "description": "EIOTClub OpenAPI PHP SDK",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "EIOTClub\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EIOTClub\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
